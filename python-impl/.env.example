# === 数据库 ===
# 方式一：PostgreSQL（Docker 部署，生产级）
# PG_DSN=postgresql+psycopg://retailguard:retailguard@localhost:15432/retailguard
# PG_DSN_SYNC=postgresql+psycopg://retailguard:retailguard@localhost:15432/retailguard
# 方式二：SQLite（本地零依赖，面试 demo 推荐）
PG_DSN=sqlite+aiosqlite:///./data/retailguard.db
PG_DSN_SYNC=sqlite:///./data/retailguard.db

# Redis（留空 = 功能降级，不影响核心流程）
REDIS_URL=
# Qdrant（留空 + APP_ENV=dev = 内存降级）
QDRANT_URL=
QDRANT_API_KEY=

# === 模型 API（按需填）===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# === 鉴权 ===
JWT_SECRET=change_me_min_32_chars_for_production_use
JWT_ALG=HS256
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# === Langfuse ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:13000

# === MCP ===
MCP_API_TOKEN=

# === 应用 ===
APP_ENV=dev
APP_DEFAULT_TENANT=tenant-a
APP_DEFAULT_VERSION=v3
LOG_LEVEL=INFO

# === RAG ===
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_COLLECTION=kb_v1
RAG_EMBED_DIM=1024
RAG_USE_LOCAL_FALLBACK=true
